# Modelo do .env do Nebula (github.com/dscalzi/Nebula).
# Copie para <clone do Nebula>/.env e troque os valores.
JAVA_EXECUTABLE=/caminho/para/jdk-21/bin/java
# ROOT: esta pasta (distro/ dentro do midgard-launcher)
ROOT=/caminho/para/midgard-launcher/distro
# BASE_URL: onde o ROOT e servido; as urls do distribution.json comecam por ela
BASE_URL=http://127.0.0.1:8080/
HELIOS_DATA_FOLDER=/caminho/para/Helios Launcher
